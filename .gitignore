# ---- credentials: never commit ----
.env
.env.*
*.pem
*.key
credentials
credentials.*
.aws/
secrets.*

# ---- generated datasets (regenerable, large) ----
all_out_bn/
all_out_rpg/
out_bn*/
out_rpg*/
dataset_generation_code/all_out_bn/
dataset_generation_code/all_out_rpg/
BN_dataset/

# ---- run artifacts ----
results/
framework_code/results/
logs/
framework_code/logs/
*.log
analysis_output/
rpg_demo_outputs/
audits/
trace_metrics/
examples/

# ---- evaluation dumps (summarize in docs instead) ----
evaluations/not_use/
evaluations/baselines*/
**/not_use/

# ---- RPG v7 run artifacts: heavy per-run dumps stay LOCAL (CLAUDE.md rule).
# Keep small summaries/reports shareable; ignore the multi-MB per-world results,
# raw per-unit CSVs, and generated world batches. (Already-tracked files under
# results_v7/mixed9_opus/ are not untracked by this — that's a separate decision.)
dataset_generation_code/rpg_v7_prototype/results_v7/**/result_*.json
dataset_generation_code/rpg_v7_prototype/results_v7/**/regrade_*.json
dataset_generation_code/rpg_v7_prototype/results_v7/**/*_data/
dataset_generation_code/rpg_v7_prototype/**/experiment_*.csv
!dataset_generation_code/rpg_v7_prototype/results_v7/**/summary.json
!dataset_generation_code/rpg_v7_prototype/results_v7/**/*report*.md
# NOTE: generated worlds (out_v7/) are deliberately NOT ignored here — they are
# the INPUT the server runs on. They are also deterministically regenerable
# (same seed -> same world), so you can either commit them or regenerate on the
# server. Decide per the runbook; do not silently strand stale worlds.

# ---- prose: only the v6 and v7 docs are shared ----
# Everything else (README, CLAUDE.md, PROJECT_STATUS, ACED and v1-v5 notes) is
# local-only, so nobody reads themselves into the wrong generation of the work.
# A doc is shared only if it lives in docs/rpg/ with _v6_ or _v7_ in the
# filename, or is a README/report inside a kept (v6/v7) prototype folder.
*.md
!dataset_generation_code/rpg_v6_prototype/**/*.md
!dataset_generation_code/rpg_v7_prototype/**/*.md

# ---- retired RPG v1-v5 line (superseded by rpg_v6_prototype/ + rpg_v7_prototype/) ----
# Still on Vivian's machine; kept off the shared branch so nobody starts work in
# the wrong generation.
results_rpg/
examples/rpg_world/
dataset_generation_code/world_gen_rpg.py
dataset_generation_code/world_gen_rpg_old.py
dataset_generation_code/audit_rpg.py
dataset_generation_code/rpg_v5_prototype/
framework_code/schemas_rpg.py
framework_code/simulator_rpg.py
framework_code/world_model_rpg.py
framework_code/scientist_agent_rpg.py
framework_code/orchestrator_rpg.py
framework_code/run_agent_batch_rpg.py
framework_code/evaluate_rpg.py

