# ---- generated datasets (regenerable, large) ----
all_out_bn/
all_out_rpg/
out_bn*/
out_rpg*/
dataset_generation_code/all_out_bn/
dataset_generation_code/all_out_rpg/
BN_dataset/

# ---- run artifacts ----
results/
framework_code/results/
logs/
framework_code/logs/
*.log
analysis_output/
rpg_demo_outputs/
audits/
trace_metrics/

# ---- evaluation dumps (summarize in docs instead) ----
evaluations/not_use/
evaluations/baselines*/
**/not_use/

# ---- prose: only the v6 docs are shared ----
# Everything else (README, CLAUDE.md, PROJECT_STATUS, ACED and v1-v5 notes) is
# local-only, so nobody reads themselves into the wrong generation of the work.
# A new doc is shared only if it lives in docs/rpg/ with _v6_ in the filename.
*.md
!docs/rpg/*_v6_*.md

# ---- retired RPG v3/v4 line (superseded by rpg_v6_prototype/) ----
